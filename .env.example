# Copy to .env in the project root; Bun loads it automatically.
# Parallel Search API key. Without it, the web_search tool is not offered to agents.
PARALLEL_API_KEY=
# OpenAI model ID (default: gpt-6-sol)
# OPENAI_MODEL=gpt-6-sol
# Reasoning level: minimal, low, medium, high, xhigh, max (default: medium)
# REASONING=medium
