{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "lib": ["ES2023", "DOM", "DOM.Iterable"],
    "jsx": "preserve",
    "types": ["irisout/jsx", "bun"],
    "allowImportingTsExtensions": true,
    "skipLibCheck": true,
    "noEmit": true,
    "isolatedModules": true,
    "strict": false
  },
  "include": ["routes", "server", "harness", "shared", "vite.config.ts"]
}
