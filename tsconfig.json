{
  "compilerOptions": {
    "target": "ESNext",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "strict": true,
    "skipLibCheck": true,
    "noEmit": true,
    "allowImportingTsExtensions": true,
    "lib": ["ESNext", "DOM"],
    "types": ["vite/client"],
    "jsx": "react-jsx",
    "paths": {
      "@/*": ["./src/*"]
    }
  },
  "exclude": ["src/**/*.test.ts"],
  "include": [
    "src",
    "cloudflare.config.ts",
    "vite.config.ts",
    "node/dashboard/app.tsx",
    ".cloudflare/types"
  ]
}
